# astro-linux618 config fragment, merged over arch/arm64/configs/defconfig
# by bin/build-kernel.sh (which fails if Kconfig drops any line here).
#
# Phase P1 "escape test" image (2026-11-25): only what the first boots
# need, and every built-in MediaTek driver that would touch the PMIC, the
# display path, the IOMMU, power domains or blocks not verified on the
# MT6873 switched off. Turn things back on one block at a time, each with
# its own receipt in docs/session-log.md.

CONFIG_LOCALVERSION="-astro"
CONFIG_LOCALVERSION_AUTO=n

# --- SoC core (MT6873 rides on MT8192) -------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT8192=y
CONFIG_PINCTRL_MT8192=y
CONFIG_MTK_TIMER=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y

# --- AGENTS.md rule 5: MT6359P access, narrowed shape only ----------------
# pwrap is the only path to the PMIC; without it no PMIC register can be
# written (power-key reset lives in STRUP_CON12; mainline mtk-pmic-keys
# writes 0x14c, which is a different register on this PMIC).
# Step 2 image B (docs/pmic-plan.md): pwrap + MT6359P MFD core + power key
# (mtk-pmic-keys with the MT6359P delta). The MFD core creates a device for
# every MT6359 function; every other driver stays off (build-boot-img.sh).
# Step 3 image A (docs/pmic-plan.md): + AUXADC (mainline mt6359-auxadc with
# the scale/IBAT delta) feeding generic-adc-battery + adc-battery-helper.
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_MEDIATEK_MT6359_AUXADC=y
CONFIG_GENERIC_ADC_BATTERY=y
# Step 3B: battery NTC (ntc_thermistor with the IIO-provider delta)
CONFIG_SENSORS_NTC_THERMISTOR=y
# GPU G-S1 (docs/gpu-stock.md): SPMI + MT6315 regulators, read-only use
# (no constraints in the DT; build-boot-img.sh checks the nodes).
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGULATOR_MT6315=y
# GPU G-S2: panfrost as a module (blacklisted on the rootfs, loaded by hand).
CONFIG_DRM_PANFROST=m
# Wi-Fi W2: module only, DT describes only the five CONSYS rails
# (build-boot-img.sh checks the regulators node).
CONFIG_REGULATOR_MT6359=m
CONFIG_RTC_DRV_MT6397=n
# Chromebook sound machine drivers select the MT6359 codec; not this board.
CONFIG_SND_SOC_MT8188_MT6359=n
CONFIG_SND_SOC_MT8192_MT6359_RT1015_RT5682=n
CONFIG_SND_SOC_MT8195_MT6359=n
CONFIG_SND_SOC_MT6359=n
CONFIG_SND_SOC_MT6359_ACCDET=n

# --- AGENTS.md rule 3: LK owns the display; Linux only reads it -----------
# Display Stage 3 (docs/display-stock.md): mediatek-drm (command-mode DSI
# delta), the MIPI PHY (MT6873 variant) and the SH8802B panel as modules,
# blacklisted on the rootfs until proven; loaded by hand in the test.
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_MEDIATEK_DP=n
CONFIG_DRM_MEDIATEK_HDMI=n
CONFIG_DRM_PANEL_SHENGHE_SH8802B=m
# Display Stage 2: mmsys + mutex built in, so the DISP domain clocks
# (mmsys CLK_MM_SMI_*) exist when the built-in scpsys probes.
CONFIG_MTK_MMSYS=y
CONFIG_MTK_IOMMU=n
CONFIG_MTK_CMDQ=n
CONFIG_PWM_MTK_DISP=n
CONFIG_PHY_MTK_MIPI_DSI=m

# --- Power domains, DVFS, blocks not verified on MT6873 --------------------
# SCPSYS would power domains on at probe; cpufreq-hw / SVS / efuse / LVTS
# use mainline-only MT8192 nodes (performance-controller@11bc10,
# svs@1100bc00, efuse@11c10000) that the vendor MT6873 DT does not have.
# Wi-Fi W2: on, with the DT spm node trimmed to the CONN domain only
# (KEEP_DEFAULT_OFF: nothing powered at probe). build-boot-img.sh refuses
# any other spm child.
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_ARM_MEDIATEK_CPUFREQ=n
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=n
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=n
CONFIG_MTK_SVS=n
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_MTK_LVTS_THERMAL=m
CONFIG_MTK_LVTS_THERMAL_DEBUGFS=y
CONFIG_MTK_SOC_THERMAL=n
CONFIG_MTK_THERMAL=y
CONFIG_MTK_DEVAPC=n
CONFIG_MTK_SCP=n
CONFIG_MMC_MTK=n
CONFIG_PCIE_MEDIATEK_GEN3=n
CONFIG_SPI_MT65XX=n

# --- Console and signs of life ---------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- USB bring-up network (right-hand port) --------------------------------
# mtu3 as device + legacy g_ether (CDC ECM), as on the Cosmo; init gives
# the Astro 10.15.21.1 and Monolith 10.15.21.2 by DHCP.
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=n

# --- Initramfs, debugging ---------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# initramfs reads the display registers LK left behind (busybox devmem,
# read only). STRICT_DEVMEM still blocks RAM; MMIO is allowed.
CONFIG_DEVMEM=y
CONFIG_KEXEC=y

# --- UFS storage (2026-11-25) ----------------------------------------------
# mainline ufs-mediatek on the legacy MT6873 host (delta: legacy-IP guards
# in ufs-mediatek.c); no VCC regulator (rule 5). sd + GPT for the LUs.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_BLK_DEV_SD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# --- Keyboard (2026-11-25) --------------------------------------------------
# AW9523B on i2c8 (only i2c8 is enabled in the DTS); Cosmo driver (delta).
CONFIG_I2C_MT65XX=y
CONFIG_KEYBOARD_AW9523=y
CONFIG_INPUT_EVDEV=y

# --- MT6360 sub-PMIC on i2c5 (2026-11-25) -----------------------------------
# Mainline drivers: core + regulators (defconfig already =y), charger
# (power_supply) and ADC (iio: VBAT, IBAT, VBUS, IBUS, TS). TCPC and LEDs
# are not described in the DTS and stay off.
CONFIG_MFD_MT6360=y
CONFIG_REGULATOR_MT6360=y
CONFIG_CHARGER_MT6360=y
CONFIG_MEDIATEK_MT6360_ADC=y
CONFIG_TYPEC_MT6360=n
CONFIG_LEDS_MT6360=n

# --- Wi-Fi: MT6873 CONSYS (docs/wifi-stock.md, W1 2026-11-25) -------------
# Vendor WMT/BTIF/gen4m stack as modules only (Kconfig: depends on m), so the
# boot image is unchanged by these. Nothing loads them until the DT has the
# consys/wifi/btif nodes (W2, needs a pre-flash check: MT6359P VCN rails).
CONFIG_MTK_WCN_CONSYS=m
CONFIG_MTK_WCN_GEN4M=m

# --- Bluetooth: MT6873 CONSYS over WMT/STP (hci_stp, as the Cosmo) --------
# All modules or bluetooth.ko options: the boot image stays the same.
CONFIG_MTK_WCN_BT_HCI=m
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HCIVHCI=m
CONFIG_UHID=m
# Game controllers over Bluetooth (DualSense/DualShock 4: hidp + hid-playstation)
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y

# --- Touch and power-off (docs/touch-stock.md, docs/poweroff.md) ---------
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_I2C=m
CONFIG_POWER_RESET_MT6359=y
