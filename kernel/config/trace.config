# Test-only tracing kernel (frame-pacing profiling, as cosmo-linux618 tr1):
# event tracing (DRM vblank/flip, gpu_scheduler, power, devfreq, sched),
# no function tracer (no mcount patching of the hot path).
# Build: KLOCAL=-tr1 KFRAG=kernel/config/trace.config bin/build-kernel.sh
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_FUNCTION_TRACER=n
