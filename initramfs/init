#!/bin/busybox sh
# Astro Slide bring-up initramfs. Derived from cosmo-linux618
# initramfs/init. Boots Debian from `userdata` when it holds one (root
# handoff below); otherwise, or after a boot that never confirmed itself,
# it stays here as the rescue system (USB shell). The only storage it
# ever writes is that userdata partition (every other UFS disk and
# partition is set read-only).
#
# Signs of life without a display or USB: the keyboard backlight (open the
# slider), driven by the gpio-leds node in the DTS.
#   heartbeat (thump-thump) = kernel running, init not reached
#   fast blink (5 Hz)       = init running and feeding the watchdog
#   solid on                = astro.wdtest=1: watchdog armed, NOT fed;
#                             the board must reset by itself in ~31-62 s
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

say() { echo "$*" > /dev/tty0 2>/dev/null; echo "astro-init: $*" > /dev/kmsg 2>/dev/null; }
LED=$(ls -d /sys/class/leds/*kbd_backlight* 2>/dev/null | head -n1)
led() { # led <trigger> [delay_on delay_off]
	[ -n "$LED" ] || return
	echo "$1" > "$LED/trigger" 2>/dev/null
	if [ "$1" = timer ]; then
		echo "$2" > "$LED/delay_on"; echo "$3" > "$LED/delay_off"
	fi
	if [ "$1" = none ]; then cat "$LED/max_brightness" > "$LED/brightness"; fi
}

# Burn-in guard first (AMOLED; docs/session-log.md 2026-11-25): LK leaves
# its last frame (orange warning, brightness 255) on the command-mode panel.
# Default: push a black frame through LK's display path (pixels off, panel
# stays initialised) and start /bin/astro-console, which shows the
# framebuffer console while there is activity and blacks it out after 60 s
# idle. If the black frame fails, or with astro.noconsole=1: hold the panel
# in reset (GPIO42 low) instead.
CONSOLE=0
if ! grep -qw astro.noconsole=1 /proc/cmdline && /bin/astro-disp black > /tmp/dispkick.txt 2>&1; then
	CONSOLE=1
else
	/bin/astro-disp reset-hold >> /tmp/dispkick.txt 2>&1
fi
console_check() { # init's main loop: a dead console helper must not leave a frame lit
	[ $CONSOLE = 1 ] || return
	if ! kill -0 "$(cat /tmp/astro-console.pid 2>/dev/null)" 2>/dev/null; then
		/bin/astro-disp blank >> /tmp/dispkick.txt 2>&1
		CONSOLE=0
		say "astro-console died: panel blanked (reset hold)"
	fi
}

say "===== Astro Slide mainline bring-up: initramfs reached ====="
say "display: $(tr '\n' ' ' < /tmp/dispkick.txt)"
[ $CONSOLE = 1 ] && { /bin/astro-console 60 & sleep 1; }
say "keyboard LED: ${LED:-not found}"

# Watchdog failsafe (AGENTS.md rule 5): from here on only this init feeds
# the SoC watchdog, so a stuck init or a hung kernel resets the board
# within ~31 s. astro.wdtest=1: arm it and never feed (escape test).
WDT=/dev/watchdog0
[ -e $WDT ] || WDT=/dev/watchdog
if exec 3>"$WDT"; then
	say "watchdog $WDT owned by init (fed every 5 s)"
else
	say "WARNING: could not open $WDT - no timer failsafe"
fi
feed() { printf . >&3 2>/dev/null; }
if grep -qw astro.wdtest=1 /proc/cmdline; then
	led none
	say "ESCAPE TEST: watchdog armed and NOT fed - board must reset in ~31-62 s"
	while true; do sleep 60; done
fi
led timer 100 100

say "$(uname -a)"
say "cmdline: $(cat /proc/cmdline)"
say "cpus online: $(cat /sys/devices/system/cpu/online)"
say "mem: $(grep -E 'MemTotal' /proc/meminfo)"
say "drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
say "pstore: $(ls /sys/fs/pstore 2>/dev/null | tr '\n' ' ')"
dmesg | grep -iE 'error|fail|unable|deferred' | tail -n 25 > /dev/tty0 2>/dev/null
dmesg > /dev/pmsg0 2>/dev/null

# Step 1 of the display plan (docs/p0-findings.md, "Consequence for first
# boot"): READ ONLY. Dumps the display registers LK left programmed, so a
# later frame kick can be checked against them. Off by default: an MMIO
# read of a clock-gated block can stall the bus (the watchdog would then
# reset the board), so it gets its own boot with astro.dispdump=1.
dump() { # dump <name> <base> <bytes>
	o=0
	while [ $o -lt $(( $3 )) ]; do
		a=$(printf '0x%x' $(( $2 + o )))
		echo "astro-disp: $1+$(printf '%03x' $o) $(devmem $a 32)" > /dev/kmsg
		o=$((o + 4))
	done
}
if grep -qw astro.dispdump=1 /proc/cmdline; then
	say "display register dump (read only) in 5 s"
	feed; sleep 5; feed
	dump mmsys  0x14000000 0x100
	dump mutex  0x14001000 0x100
	dump ovl0   0x14005000 0x100
	dump ovl2l0 0x14006000 0x100
	dump rdma0  0x14007000 0x100
	dump dsi0   0x14010000 0x200
	feed
	say "display register dump done"
	dmesg | grep astro-disp > /dev/pmsg0 2>/dev/null
fi

# Bring-up network over USB (right-hand port): g_ether (CDC ECM) on mtu3.
# The Astro is 10.15.21.1; udhcpd hands Monolith 10.15.21.2 (no router or
# DNS, so the host keeps its own default route). Cable-only, no auth:
#   telnet 10.15.21.1          interactive shell
#   socat - TCP:10.15.21.1:2323   one shell per connection (scripted use)
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mkdir -p /sys/kernel/debug && mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
n=0
while [ ! -e /sys/class/net/usb0 ] && [ $n -lt 20 ]; do feed; sleep 1; n=$((n+1)); done
if [ -e /sys/class/net/usb0 ]; then
	ifconfig lo 127.0.0.1 up
	ifconfig usb0 10.15.21.1 netmask 255.255.255.0 up
	printf '%s\n' "start 10.15.21.2" "end 10.15.21.2" "interface usb0" \
		"max_leases 1" "lease_file /tmp/udhcpd.leases" \
		"option subnet 255.255.255.0" > /tmp/udhcpd.conf
	touch /tmp/udhcpd.leases
	udhcpd /tmp/udhcpd.conf && say "udhcpd on usb0"
	telnetd -l /bin/sh && say "telnetd up: telnet 10.15.21.1"
	nc -lk -p 2323 -e /bin/sh &
	NCPID=$!
	say "shell port up: socat - TCP:10.15.21.1:2323"
else
	say "no usb0 after 20 s; udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
fi
dmesg > /dev/pmsg0 2>/dev/null

# USB registers (usb2, 2026-11-25): read-only dump on every boot, into the
# diagnostic record. Addresses: vendor phy-mtk-mt6873.c V2 layout = mainline
# tphy u2port0 (0x11e40000, U2 common bank +0x300) + u3port0 (0x11e40700,
# U3 PHYA bank +0x400 = 0x11e40b00); IPPC 0x11203e00; MAC 0x11201000;
# GPIO base 0x10005000 (DIR +0x000, DOUT +0x100, DIN +0x200, MODE +0x300).
rd() { devmem "$1" 32 2>/dev/null; }
regdump() { # regdump <name> <base> <bytes>
	o=0
	while [ $o -lt $(( $3 )) ]; do
		a=$(( $2 + o ))
		echo "reg $1+$(printf '%03x' $o) @$(printf '0x%08x' $a) = $(rd $(printf '0x%x' $a))"
		o=$((o + 4))
	done
}
usbregs() {
	echo "--- usb registers ($1)"
	regdump u2com 0x11e40300 0x80
	regdump u2misc 0x11e40000 0x20
	regdump u3phya 0x11e40b00 0x10
	regdump ippc 0x11203e00 0x60
	regdump mac 0x11201000 0x40
	echo "gpio dir0 $(rd 0x10005000) dir3 $(rd 0x10005030)"
	echo "gpio dout0 $(rd 0x10005100) dout3 $(rd 0x10005130)"
	echo "gpio din0 $(rd 0x10005200) din3 $(rd 0x10005230)"
	echo "gpio mode1 $(rd 0x10005310) (pin13 = bits 23:20) mode15 $(rd 0x100053f0) (pin127 = bits 31:28)"
	echo "udc state: $(cat /sys/class/udc/*/state 2>/dev/null)"
}
setbits() { v=$(rd $1); devmem $1 32 $(( v | $2 )); }
clrbits() { v=$(rd $1); devmem $1 32 $(( v & ~$2 )); }
usbregs boot > /tmp/usbregs.txt
# astro.usbforce=1: the vendor PHY power-on values mainline tphy does not
# write (phy-mtk-mt6873.c phy_init_soc): U2PHYDTM1 (0x11e4036c)
# FORCE_VBUSVALID bit 13, FORCE_SESSEND bit 12, FORCE_AVALID bit 10 with
# RG_VBUSVALID bit 5 = 1, RG_AVALID bit 2 = 1, RG_SESSEND bit 4 = 0; then
# RG_SSUSB_VUSB10_ON (0x11e40b04 bit 29). State re-read after each step.
if grep -qw astro.usbforce=1 /proc/cmdline; then
	setbits 0x11e4036c $(( (1<<13) | (1<<10) | (1<<12) | (1<<5) | (1<<2) ))
	clrbits 0x11e4036c $(( 1<<4 ))
	feed; sleep 3; feed
	echo "after vbus/avalid/sessend force: $(cat /sys/class/udc/*/state 2>/dev/null)" >> /tmp/usbregs.txt
	if [ "$(cat /sys/class/udc/*/state 2>/dev/null)" = "not attached" ]; then
		setbits 0x11e40b04 $(( 1<<29 ))
		feed; sleep 3; feed
		echo "after VUSB10_ON: $(cat /sys/class/udc/*/state 2>/dev/null)" >> /tmp/usbregs.txt
	fi
	usbregs after-force >> /tmp/usbregs.txt
	say "usbforce: $(tail -n 1 /tmp/usbregs.txt)"
fi

# USB diagnosis without a working link (usb1, 2026-11-25): after the
# network setup, the keyboard light switches from the fast blink to a
# repeating blink code (N short blinks, pause):
#   1 = no UDC (mtu3 did not probe)      2 = UDC but no usb0
#   3 = UDC "not attached" (no link seen) 4 = link but not configured
#   5 = configured
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
# The host needs a moment to enumerate: wait up to 10 s for "configured"
# (usb3: the state read right after usb0 appeared was still "not attached").
n=0
while [ -n "$UDC" ] && [ "$(cat /sys/class/udc/$UDC/state 2>/dev/null)" != configured ] && [ $n -lt 10 ]; do
	feed; sleep 1; n=$((n+1))
done
UDCSTATE=$( [ -n "$UDC" ] && cat /sys/class/udc/$UDC/state 2>/dev/null)
if [ -z "$UDC" ]; then CODE=1
elif [ ! -e /sys/class/net/usb0 ]; then CODE=2
elif [ "$UDCSTATE" = "not attached" ]; then CODE=3
elif [ "$UDCSTATE" != "configured" ]; then CODE=4
else CODE=5; fi
say "usb diag: udc=${UDC:-none} state=${UDCSTATE:-n/a} code=$CODE"
diag() {
	echo "=== ASTRO-DIAG $(cut -d' ' -f1 /proc/uptime) code=$CODE udc=${UDC:-none} state=${UDCSTATE:-n/a}"
	cat /tmp/usbregs.txt 2>/dev/null
	echo "--- devices_deferred"; cat /sys/kernel/debug/devices_deferred 2>/dev/null
	echo "--- udc"; for f in /sys/class/udc/*/*; do [ -f "$f" ] && echo "$f: $(cat $f 2>/dev/null)"; done
	echo "--- gpio"; cat /sys/kernel/debug/gpio 2>/dev/null
	echo "--- dmesg (usb/phy)"; dmesg | grep -iE "mtu3|usb|phy|udc|gadget|g_ether|astro"
	echo "--- dmesg (ufs/scsi/i2c/keyboard)"; dmesg | grep -iE "ufs|scsi|sd[a-z]|i2c|aw9523|input"
	echo "=== ASTRO-DIAG-END"
}
diag > /dev/pmsg0 2>/dev/null
# Blink the code once, then leave the keyboard light off. Only a USB
# failure (code 1-4: no shell to ask) keeps repeating it.
if [ -n "$LED" ]; then
	echo none > "$LED/trigger"
	( while true; do
		k=0
		while [ $k -lt $CODE ]; do
			echo 1 > "$LED/brightness"; usleep 250000
			echo 0 > "$LED/brightness"; usleep 350000
			k=$((k+1))
		done
		[ $CODE = 5 ] && break
		sleep 2
	done ) &
	BLINKPID=$!
fi
# astro.logreset=1: log-channel test. Stop feeding the watchdog 30 s after
# the diagnosis, so the board resets by itself (watchdog, not power key)
# and the pmsg record above can be looked for with `mtk da peek` in the
# pstore region (0x4d010000) right after the reset.
LOGRESET=0
grep -qw astro.logreset=1 /proc/cmdline && LOGRESET=1

# UFS bring-up (2026-11-25): the UFS LUs hold the bootloaders, both slots
# and the device-unique partitions. Until a write path is decided, every
# SCSI disk and partition is set read-only as soon as it appears (the
# UFS scan is asynchronous; the main loop checks every 5 s, and nothing
# in this initramfs opens them for writing meanwhile).
# astro.ufsrw=1 skips this.
UFSRO=1
grep -qw astro.ufsrw=1 /proc/cmdline && UFSRO=0
# Walks sysfs, not /dev: devtmpfs creates the partition nodes a moment
# after the partitions appear, and a /dev walk at the wrong moment missed
# most of sdc (root1 boot, 2026-11-25). A missing node is made here.
blknode() { # sysfs block name -> /dev node (created if devtmpfs lags)
	[ -b "/dev/$1" ] || mknod "/dev/$1" b $(tr ':' ' ' < "/sys/class/block/$1/dev") 2>/dev/null
	echo "/dev/$1"
}
ufs_ro() {
	[ $UFSRO = 1 ] || return 0
	for b in /sys/class/block/sd*; do
		[ -e "$b/dev" ] || continue
		[ "$(cat "$b/ro" 2>/dev/null)" = 1 ] || blockdev --setro "$(blknode "${b##*/}")"
	done
}
# Every sd disk/partition except the named ones reads back read-only.
ufs_ro_ok() { # ufs_ro_ok <allowed rw names...>
	for b in /sys/class/block/sd*; do
		n=${b##*/}
		case " $* " in *" $n "*) continue ;; esac
		[ "$(cat "$b/ro" 2>/dev/null)" = 1 ] || { echo "$n"; return 1; }
	done
	return 0
}

# ---- Root filesystem handoff (Debian on userdata, 2026-11-25) -------------
# Boots /sbin/init from the ext4 on `userdata` (sdc56) when it looks like a
# system. Only that partition and its disk are made writable; every other
# UFS disk and partition stays read-only.
# Tripwire: the Astro has no `cache` partition, so the flag is a file on
# the root filesystem itself, /var/lib/astro-boot/state. Before the handoff
# this writes TRY; the root system's astro-boot-ok.service writes OK once
# multi-user.target is reached. A boot that finds TRY (the last handoff
# never reported in, e.g. it hung and was reset by the power key or the
# watchdog) writes RSC and stays here in the rescue initramfs; the next
# boot tries again. astro.noroot on the cmdline always stays here.
part() { # GPT name -> /dev/sdXN
	for b in /sys/class/block/sd*; do
		grep -qx "PARTNAME=$1" "$b/uevent" 2>/dev/null && { echo "/dev/${b##*/}"; return; }
	done
}
STATE=/newroot/var/lib/astro-boot/state
state_set() { mkdir -p "${STATE%/*}" && printf '%s\n' "$1" > "$STATE.new" && mv "$STATE.new" "$STATE"; sync; }
root_abort() { umount /newroot 2>/dev/null; ufs_ro; say "$1: staying in the rescue initramfs"; }
try_root() {
	grep -qw astro.noroot /proc/cmdline && { say "astro.noroot: staying in the rescue initramfs"; return; }
	n=0
	while [ -z "$(part userdata)" ] && [ $n -lt 15 ]; do feed; sleep 1; n=$((n+1)); done
	ROOTDEV=$(part userdata)
	[ -n "$ROOTDEV" ] || { say "userdata not found: staying here"; return; }
	# Partitions appear together; give udev-less /dev and sysfs a moment.
	sleep 1
	ufs_ro	# everything read-only first, then open exactly userdata + its disk
	DISKN=$(basename "$(dirname "$(readlink -f /sys/class/block/${ROOTDEV#/dev/})")")
	ROOTN=${ROOTDEV#/dev/}
	blockdev --setrw "$(blknode $DISKN)" && blockdev --setrw "$(blknode $ROOTN)" \
		|| { root_abort "could not make $ROOTDEV writable"; return; }
	# Gate: nothing but userdata and its disk may be writable.
	if [ $UFSRO = 1 ] && ! bad=$(ufs_ro_ok $DISKN $ROOTN); then
		root_abort "$bad is not read-only"; return
	fi
	say "UFS: only $DISKN + $ROOTN writable ($(ls -d /sys/class/block/sd* | wc -l) sd devices checked)"
	mkdir -p /newroot
	mount -t ext4 -o rw,noatime "$ROOTDEV" /newroot 2>/dev/null || { root_abort "no ext4 root on $ROOTDEV"; return; }
	if [ ! -x /newroot/sbin/init ] || [ ! -f /newroot/etc/os-release ]; then
		root_abort "$ROOTDEV has no /sbin/init or os-release"; return
	fi
	last=$(cat "$STATE" 2>/dev/null)
	if [ "$last" = TRY ]; then
		state_set RSC
		root_abort "last root boot never reported in (RESCUE; next boot tries again)"
		return
	fi
	state_set TRY
	say "booting $(. /newroot/etc/os-release; echo "$PRETTY_NAME") from $ROOTDEV (last state: ${last:-none})"
	feed
	# Rescue helpers go; the root system has its own (astro-console.service).
	# Pixels off until it starts (burn-in rule).
	kill "$(cat /tmp/astro-console.pid 2>/dev/null)" ${BLINKPID:-} ${NCPID:-} 2>/dev/null
	killall telnetd udhcpd 2>/dev/null
	CONSOLE=0
	usleep 400000	# let a frame kick the helper had started finish
	/bin/astro-disp black >> /tmp/dispkick.txt 2>&1
	[ -n "$LED" ] && echo 0 > "$LED/brightness"
	ifconfig usb0 0.0.0.0 down 2>/dev/null
	# Hand the watchdog to systemd (RuntimeWatchdogSec=30s): closing without
	# the magic character leaves it running, so a hang before systemd opens
	# it still resets the board.
	feed
	exec 3>&-
	for m in /dev /proc /sys; do
		mkdir -p "/newroot$m"
		mount -o move "$m" "/newroot$m" 2>/dev/null || umount -l "$m" 2>/dev/null
	done
	exec switch_root /newroot /sbin/init
}
[ $LOGRESET = 1 ] || try_root

i=0
while true; do
	console_check
	ufs_ro
	if [ $LOGRESET = 1 ] && [ $i -ge 6 ]; then
		say "logreset: watchdog no longer fed; reset in ~31 s"
		diag > /dev/pmsg0 2>/dev/null
		sync
		while true; do sleep 60; done
	fi
	feed
	sleep 5
	i=$((i+1))
	[ $((i % 6)) -eq 0 ] && echo "astro-init: alive, uptime $(cut -d' ' -f1 /proc/uptime) s" > /dev/kmsg
done
