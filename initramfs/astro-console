#!/bin/busybox sh
# astro-console [idle-seconds]: make the framebuffer console visible on the
# command-mode SH8802B, with a burn-in bound (AMOLED).
#
# The panel only changes when a frame is sent, so while the console is
# "active" this sends ~5 frames/s through LK's display path
# (/bin/astro-disp kick). Active = a new kernel message, a keypress (the
# keyboard's i2c8 interrupt count changed), or `astro-disp wake` (touches
# /tmp/console-wake). After IDLE seconds
# (default 60) without either, it sends a black frame (OLED pixels off) and
# stops sending frames until the next activity.
#
# init checks that this process is alive and blanks the panel if it is not
# (a dead helper must never leave a frozen console lit).
IDLE=${1:-60}
echo $$ > /tmp/astro-console.pid
on=0
quiet=0
last=""
show() { [ $on = 1 ] || { /bin/astro-disp fb > /dev/null 2>&1; on=1; }; quiet=0; }
hide() { [ $on = 0 ] || { /bin/astro-disp black > /dev/null 2>&1; on=0; }; }
show
t=0
while true; do
	if [ $t -ge 5 ]; then	# once a second: look for activity
		t=0
		# init's 30 s "alive" heartbeat is not activity (it kept the
		# panel lit forever, 2026-11-25).
		cur="$(dmesg | grep -v 'astro-init: alive' | tail -n 1) $(grep -m1 '11d01100.i2c' /proc/interrupts)"
		if [ -e /tmp/console-wake ] || [ "$cur" != "$last" ]; then
			rm -f /tmp/console-wake
			last="$cur"
			show
		else
			quiet=$((quiet + 1))
			[ $quiet -ge $IDLE ] && hide
		fi
	fi
	[ $on = 1 ] && /bin/astro-disp kick > /dev/null 2>&1
	usleep 200000
	t=$((t + 1))
done
